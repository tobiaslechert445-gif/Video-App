{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My View",
  "version": "1.1.0",
  "identifier": "com.mymediaapp.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "My View",
        "width": 1400,
        "height": 900,
        "decorations": false,
        "maximized": true,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--allow-file-access-from-files --disable-web-security --autoplay-policy=no-user-gesture-required --disable-popup-blocking"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
